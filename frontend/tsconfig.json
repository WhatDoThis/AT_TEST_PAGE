{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@adobe/*": ["./adobe_frontend/target_frontend/*"],
      "@adobe-native/*": ["./adobe_frontend/target-native-frontend/*"],
      "@ga4/*": ["./ga4_frontend/ga4-test/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../env/**/*.json"
  ]
}
